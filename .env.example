# Copie este arquivo para .env.local e preencha.
# Sem as variáveis do Supabase, o sistema roda em MODO DEMONSTRAÇÃO
# (dados na memória, só para testar no próprio computador).

# --- Supabase (Project Settings > API Keys) ---------------------------
# Endereço do projeto
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Chave pública: "Publishable key" (ou a antiga "anon public")
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta: "Secret key" (ou a antiga "service_role"). NUNCA compartilhe.
SUPABASE_SERVICE_ROLE_KEY=

# --- Painel do restaurante -------------------------------------------
# Senha para entrar em /admin. Obrigatória quando o Supabase está configurado.
ADMIN_PASSWORD=
# --- Bomo123@ # 

# --- Opcionais ---------------------------------------------------------
# Endereço público usado nos QR Codes. Se ficar vazio, usa o endereço
# pelo qual o painel foi aberto. Recomendado em produção.
# SITE_URL=https://chamados.meurestaurante.com.br

# Nome do restaurante, usado como texto alternativo da logo.
# NOME_RESTAURANTE=Cantina da Praça
